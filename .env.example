# NightWatch AI - DevOps Incident Command Console & Autonomous Voice Escalator

# Set to true for local testing without live API keys (uses simulated voice transcript and safe dry-run actions)
DEMO_MODE=true

# Public HTTPS URL for Agora Conversational AI custom tools webhook (e.g. ngrok tunnel)
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app

# Shared secret for authenticating Agora ConvoAI mid-call HTTPS tools
TOOL_WEBHOOK_SECRET=nightwatch-dev-secret-2026

# Agora Credentials (https://console.agora.io)
# Conversational AI Engine must be enabled in project settings
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Options: openai_compat | native | managed
GEMINI_AGORA_MODE=openai_compat

# Optional Agora RTM Transcripts (default false so RTM never blocks RTC audio)
ENABLE_RTM_TRANSCRIPTS=false

# Murf AI API Key (Falcon TTS streaming: wss://global.api.murf.ai/v1/speech/stream-input)
# If empty, Agora automatically falls back to Agora Managed MiniMax TTS (speech-2.6-turbo)
MURF_API_KEY=

# GitHub Integration (Optional - falls back to safe dry run if empty)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_ROLLBACK_WORKFLOW=rollback.yml
